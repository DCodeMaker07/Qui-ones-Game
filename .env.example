# Dirección del servidor multijugador (se lee al compilar el juego). Cópialo como .env.production o defínelo en Netlify/Vercel/GitHub Actions.
# Con esto el jugador no escribe nada: el juego ya sale apuntando a este servidor. El campo "Servidor" solo aparece en desarrollo o con ?ws=...
# En desarrollo no hace falta: se usa ws://localhost:8080 (pnpm servidor).
VITE_WS_URL=wss://TU-SERVICIO.onrender.com
